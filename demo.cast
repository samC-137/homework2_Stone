{"version": 2, "width": 178, "height": 15, "timestamp": 1791808599, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.045466, "o", "Введите команду. Для списка команд введите help.\r\n>>> Введите команду: "]
[5.382247, "o", "create table users (name:str, age:int, active:bool)"]
[5.724103, "o", "\r\n"]
[5.725788, "o", "Ошибка валидации: Таблица users уже существует\r\n"]
[5.72587, "o", ">>> Введите команду: "]
[7.707418, "o", "list_tables"]
[7.862543, "o", "\r\n"]
[7.862857, "o", "students\r\nusers\r\n"]
[7.862908, "o", ">>> Введите команду: "]
[10.854767, "o", "info users"]
[10.963037, "o", "\r\n"]
[10.964725, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, active:bool\r\nКоличество записей: 2\r\n"]
[10.964768, "o", ">>> Введите команду: "]
[13.685187, "o", "insert into users values (\"Анна\", 20, true)"]
[13.828396, "o", "\r\n"]
[13.829782, "o", "Запись с ID=3 успешно добавлена в таблицу users.\r\n"]
[13.829868, "o", "Функция _insert выполнилась за 0.001 секунд\r\n>>> Введите команду: "]
[16.291204, "o", "insert into users values (\"Антон\", 40, true)"]
[16.441407, "o", "\r\n"]
[16.442477, "o", "Запись с ID=4 успешно добавлена в таблицу users.\r\nФункция _insert выполнилась за 0.001 секунд\r\n"]
[16.442587, "o", ">>> Введите команду: "]
[18.673632, "o", "select from users"]
[18.800171, "o", "\r\n"]
[18.830098, "o", "+----+-------+-----+--------+\r\n| ID |  name | age | active |\r\n+----+-------+-----+--------+\r\n| 1  |  Анна |  21 |  True  |\r\n| 2  | Антон |  40 |  True  |\r\n| 3  |  Анна |  20 |  True  |\r\n| 4  | Антон |  40 |  True  |\r\n+----+-------+-----+--------+\r\nФункция _select выполнилась за 0.030 секунд\r\n"]
[18.83019, "o", ">>> Введите команду: "]
[20.947767, "o", "select from users where age=20"]
[21.094705, "o", "\r\n"]
[21.095788, "o", "+----+------+-----+--------+\r\n| ID | name | age | active |\r\n+----+------+-----+--------+\r\n| 3  | Анна |  20 |  True  |\r\n+----+------+-----+--------+\r\n"]
[21.095818, "o", "Функция _select выполнилась за 0.001 секунд\r\n>>> Введите команду: "]
[23.326704, "o", "update users set age=21 where ID=1"]
[23.522669, "o", "\r\n"]
[23.523793, "o", "Данные таблицы users успешно обновлены\r\n"]
[23.523811, "o", ">>> Введите команду: "]
[27.571494, "o", "delete from users where ID=1"]
[27.782738, "o", "\r\n"]
[27.783559, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[29.171891, "o", "t"]
[29.521542, "o", "\b \b"]
[29.57656, "o", "y"]
[30.01361, "o", "\r\n"]
[30.015102, "o", "Записи из таблицы users успешно удалены\r\n>>> Введите команду: "]
[35.030705, "o", "select from users"]
[35.190805, "o", "\r\n"]
[35.19149, "o", "+----+-------+-----+--------+\r\n| ID |  name | age | active |\r\n+----+-------+-----+--------+\r\n| 2  | Антон |  40 |  True  |\r\n| 3  |  Анна |  20 |  True  |\r\n| 4  | Антон |  40 |  True  |\r\n+----+-------+-----+--------+\r\nФункция _select выполнилась за 0.001 секунд\r\n"]
[35.191501, "o", ">>> Введите команду: "]
[43.487109, "o", "drop table users"]
[43.807043, "o", "\r\n"]
[43.807586, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[45.14239, "o", "y"]
[45.661059, "o", "\r\n"]
[45.66203, "o", "Таблица users успешно удалена\r\n>>> Введите команду: "]
[48.642917, "o", "help"]
[48.788329, "o", "\r\n"]
[48.788624, "o", "Команды:\r\n  create table <имя> (<столбец>:<тип>, ...)\r\n  drop table <имя>\r\n  list_tables\r\n  insert into <имя> values (<значение>, ...)\r\n  select from <имя> [where <столбец> = <значение>]\r\n  update <имя> set <столбец> = <значение> where <столбец> = <значение>\r\n  delete from <имя> where <столбец> = <значение>\r\n  info <имя>\r\n  help\r\n  exit\r\n"]
[48.788788, "o", ">>> Введите команду: "]
[51.051109, "o", "exit"]
[51.401332, "o", "\r\n"]
