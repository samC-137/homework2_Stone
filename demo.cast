{"version": 2, "width": 0, "height": 0, "timestamp": 1791794725, "env": {"SHELL": "/bin/zsh", "TERM": "dumb"}, "title": "Primitive DB demo"}
[0.05266, "o", "Введите команду. Для списка команд введите help.\r\n>>> Введите команду: "]
[0.05307, "i", "create table books title:str year:int\n"]
[0.053148, "o", "create table books title:str year:int\r\n"]
[0.053741, "o", "Таблица books успешно создана\r\n>>> Введите команду: "]
[0.157883, "i", "insert into books values (\"Dune\", 1965)\n"]
[0.158038, "o", "insert into books values (\"Dune\", 1965)\r\n"]
[0.158518, "o", "Запись с ID=1 успешно добавлена в таблицу books.\r\nФункция _insert выполнилась за 0.000 секунд\r\n"]
[0.158575, "o", ">>> Введите команду: "]
[0.261663, "i", "select from books\n"]
[0.261884, "o", "select from books\r\n"]
[0.284946, "o", "+----+-------+------+\r\n| ID | title | year |\r\n+----+-------+------+\r\n| 1  |  Dune | 1965 |\r\n+----+-------+------+\r\nФункция _select выполнилась за 0.023 секунд\r\n"]
[0.285011, "o", ">>> Введите команду: "]
[0.364381, "i", "update books set year=1966 where ID=1\n"]
[0.364562, "o", "update books set year=1966 where ID=1\r\n"]
[0.365146, "o", "Данные таблицы books успешно обновлены\r\n>>> Введите команду: "]
[0.465013, "i", "select from books\n"]
[0.465141, "o", "select from books\r\n"]
[0.465573, "o", "+----+-------+------+\r\n| ID | title | year |\r\n+----+-------+------+\r\n| 1  |  Dune | 1966 |\r\n+----+-------+------+\r\n"]
[0.46558, "o", "Функция _select выполнилась за 0.000 секунд\r\n"]
[0.465639, "o", ">>> Введите команду: "]
[0.565145, "i", "delete from books where ID=1\n"]
[0.565262, "o", "delete from books where ID=1\r\n"]
[0.565681, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[0.670275, "i", "y\n"]
[0.670445, "o", "y\r\n"]
[0.670925, "o", "Записи из таблицы books успешно удалены\r\n"]
[0.670944, "o", ">>> Введите команду: "]
[0.774158, "i", "info books\n"]
[0.774716, "o", "info books\r\n"]
[0.775448, "o", "Таблица: books\r\nСтолбцы: ID:int, title:str, year:int\r\nКоличество записей: 0\r\n>>> Введите команду: "]
[0.878942, "i", "drop table books\n"]
[0.879304, "o", "drop table books\r\n"]
[0.879662, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[0.981137, "i", "y\n"]
[0.981488, "o", "y\r\n"]
