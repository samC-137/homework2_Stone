[56.605499, "i", "\r"]
[56.605757, "o", "\r\n"]
[56.605897, "o", "Команды:\r\n  create table <имя> (<столбец>:<тип>, ...)\r\n  drop table <имя>\r\n  list_tables\r\n  insert into <имя> values (<значение>, ...)\r\n  select from <имя> [where <столбец> = <значение>]\r\n  update <имя> set <столбец> = <значение> where <столбец> = <значение>\r\n  delete from <имя> where <столбец> = <значение>\r\n  info <имя>\r\n  help\r\n  exit\r\n>>> Введите команду: "]
[59.956882, "i", "exit"]
[59.957104, "o", "exit"]
[60.088592, "i", "\r"]
[60.088818, "o", "\r\n"]
